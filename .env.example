# Copy this file to .env and edit it. Never commit .env.

# ---------- Provider: the one switch between local and cloud ----------
# ollama = fully offline (default), openai = cloud (needs OPENAI_API_KEY)
PROVIDER=ollama

# ---------- Ollama (local) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
# llama3.2-vision is about 8 GB and slow on CPU. Use "llava" if captioning is too slow.
OLLAMA_VISION_MODEL=llama3.2-vision

# ---------- OpenAI (cloud, optional) ----------
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# local = BAAI/bge-small-en-v1.5 (offline). openai = text-embedding-3-small.
# Changing this means the index has to be rebuilt, so it does not follow PROVIDER.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Re-ranker ----------
RERANKER_MODEL=BAAI/bge-reranker-base
# Smaller model to use if memory is tight
RERANKER_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- Chunking ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------- Retrieval ----------
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_N=5

# ---------- Ingestion ----------
# Skip images smaller than this (pixels, width and height) - logos, icons
MIN_IMAGE_SIZE=100
# A page with fewer extractable characters than this is treated as a possible scan
OCR_MIN_TEXT_CHARS=50
# ...and is OCR'd if one image covers at least this fraction of the page
OCR_IMAGE_COVERAGE=0.6
# Full path to tesseract.exe if it is not on PATH (Windows), e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---------- Conversation ----------
MEMORY_TURNS=4

# ---------- Storage and logging ----------
# Relative to the project folder, or an absolute path
DATA_DIR=data
CHROMA_COLLECTION=documents
LOG_LEVEL=INFO
