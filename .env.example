# Copy this file to .env and edit it. Never commit .env.

# ---------- Provider: the one switch between local and cloud ----------
# ollama = fully offline (default), openai = cloud (needs OPENAI_API_KEY)
PROVIDER=ollama

# ---------- Ollama (local) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
# Context window of the chat model in tokens. 8192 is safe for long tables;
# 4096 saves about 0.5-1 GB of RAM on an 8 GB laptop.
OLLAMA_NUM_CTX=8192
# llava (about 4.7 GB) is the default: recent Ollama versions (e.g. 0.40) cannot load
# llama3.2-vision ("unknown model architecture: mllama"). If your Ollama can, you may use it.
OLLAMA_VISION_MODEL=llava

# ---------- OpenAI (cloud, optional) ----------
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# local = BAAI/bge-small-en-v1.5 (offline). openai = text-embedding-3-small.
# Changing this means the index has to be rebuilt, so it does not follow PROVIDER.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Re-ranker ----------
RERANKER_MODEL=BAAI/bge-reranker-base
# Smaller, ~14x faster model. Used automatically on machines with less than 10 GB RAM,
# or if the main model fails to load. On a slow CPU you can also set RERANKER_MODEL to it.
RERANKER_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- Chunking ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------- Retrieval ----------
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_TOP_N=5

# ---------- Ingestion ----------
# Skip images smaller than this (pixels, width and height) - logos, icons
MIN_IMAGE_SIZE=100
# A page with fewer extractable characters than this is treated as a possible scan
OCR_MIN_TEXT_CHARS=50
# ...and is OCR'd if one image covers at least this fraction of the page
OCR_IMAGE_COVERAGE=0.6
# Full path to tesseract.exe if it is not on PATH (Windows), e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Ask the LLM for a one-line summary of each table when indexing (slower on CPU).
# If the LLM is unavailable, a summary built from the table header is used instead.
LLM_TABLE_SUMMARIES=true

# Describe figures/charts with the vision model when indexing. On a CPU this can take
# 1-3 minutes per figure with llama3.2-vision, so at most MAX_FIGURES_PER_DOC are captioned.
CAPTION_FIGURES=true
MAX_FIGURES_PER_DOC=25

# ---------- Conversation ----------
MEMORY_TURNS=4

# ---------- Storage and logging ----------
# Relative to the project folder, or an absolute path
DATA_DIR=data
CHROMA_COLLECTION=documents
LOG_LEVEL=INFO
